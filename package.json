{
  "name": "rivblock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs",
    "site": "npm run build && node scripts/site.mjs",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "shots": "npm run build && node tests/store-shots.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/cli": "^7.6.11",
    "@capacitor/ios": "^7.6.11",
    "playwright-core": "^1.49.1",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.11",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6"
  }
}
